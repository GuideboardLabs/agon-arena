# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/

# Results (generated at runtime)
results/

# Benchmark database — 800KB+ of generated data, rebuilt by the runner.
# Keep it out of git; the per-event tables are the source of truth.
agon-bench.db
agon-bench.db.*
*.db-journal
*.db-wal
*.db-shm

# Generated schema/diagram artifacts (regenerable from the DB)
agon-bench-er.*
agon-bench-schema*
*.png

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/

# Runtime stderr logs — GB-scale, appended across every bench session
server-stderr.log
server-stderr.log.*
sweep-stderr.log
*-stderr.log

# Scratch / empty databases left by experiments
benchmark.db
benchmark_results.db

# Editor and variant backups of the harness
*.bak
*.bak-*
*~

# Benchmark scrape output — agent tasks write example.com HTML into CWD
example.com/
example_com/
output/
scripts/output/
scripts/example_com/

# Sprint sweep raw output (regenerable; summaries live in results/)
sprint-results/

.idea/
*.swp
*.swo
